{
  "opencollection": "1.0.0",
  "info": {
    "name": "Proxmox VE Access Cluster API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cluster",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get API version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}:8006/api2/json/version"
          },
          "docs": "Return the current API version of the Proxmox VE node."
        }
      ]
    }
  ],
  "bundled": true
}